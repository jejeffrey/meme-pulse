# 내 컴퓨터에서 수집할 때만 사용합니다. 이 파일을 복사해 이름을 keys.env 로 바꾸고 값을 채우세요.
# GitHub 자동 수집에서는 이 파일 대신 Settings > Secrets 에 같은 이름으로 넣습니다.
SEOUL_API_KEY=
AIRKOREA_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 선택 (X 유료 API 이용 시)
X_BEARER_TOKEN=
# 선택 (유튜브 업로드 수·조회수, 무료)
YOUTUBE_API_KEY=
# 선택 (인스타그램 전문가 계정 + Meta 앱)
IG_USER_ID=
IG_ACCESS_TOKEN=
# 선택 (구글 지도 리뷰 수, 결제 계정 등록 필요)
GOOGLE_MAPS_API_KEY=
